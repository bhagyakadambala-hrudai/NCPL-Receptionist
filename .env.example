# ============================================================
# NCPL AI Receptionist — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ── AI Provider ─────────────────────────────────────────────
# Choose "claude" (better quality) or "gemini" (free tier)
AI_PROVIDER=claude

# Anthropic / Claude — get key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — get free key at aistudio.google.com
# Only needed if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Voice for Twilio <Say> — Amazon Polly voices
# Options: Polly.Joanna (female), Polly.Matthew (male), Polly.Amy (British)
TWILIO_VOICE=Polly.Joanna

# ── Server ──────────────────────────────────────────────────
# Set to your Vercel deployment URL after deploying
BASE_URL=https://your-app.vercel.app

# ── Database ────────────────────────────────────────────────
# PostgreSQL required for Vercel deployment.
# Get a free database at neon.tech → copy the connection string.
# For local development only, SQLite works: sqlite:///./ncpl.db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
