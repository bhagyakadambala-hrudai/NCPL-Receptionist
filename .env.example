# ============================================================
# NCPL AI Receptionist — Environment Configuration
# Copy this file to .env and fill in your API keys.
# ============================================================

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (Text-to-Speech)
# Get your key at: https://elevenlabs.io
# Leave blank to fall back to Twilio's built-in TTS (Polly voices)
ELEVENLABS_API_KEY=
# Default voice: Rachel (professional female). Browse voices at elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio (Phone calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Server
# For local dev with ngrok: set to your ngrok HTTPS URL, e.g. https://abc123.ngrok.io
# For production: set to your public server URL
BASE_URL=http://localhost:8000

# Database (SQLite by default — no extra setup needed)
DATABASE_URL=sqlite:///./ncpl_receptionist.db
